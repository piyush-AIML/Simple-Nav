# Byte-compiled / cache
__pycache__/
*.pyc
.pytest_cache/

# Generated data — regenerate by running the pipeline, don't commit large binaries
data/raw_video.mp4

# Private media — never commit images or videos from data/
data/**/*.bmp
data/**/*.gif
data/**/*.jpeg
data/**/*.jpg
data/**/*.mov
data/**/*.mp4
data/**/*.mpeg
data/**/*.mpg
data/**/*.png
data/**/*.webm
data/**/*.webp
data/**/*.avi

data/frames/*
!data/frames/.gitkeep
data/test_labels.json

# Environments
venv/
.venv/
*.egg-info/

# OS/editor cruft
.DS_Store
.idea/
.vscode/
yolov8n.pt

